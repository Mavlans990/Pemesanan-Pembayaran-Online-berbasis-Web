<!-- ================= MAIN ================= -->

<div class="main">
  <!-- Top Navbar -->
  <nav class="topbar d-flex align-items-center justify-content-between">
    <div>
      <h6 class="mb-0">Pesanan</h6>

      <small class="text-muted"> Management / Pesanan </small>
    </div>

    <!-- User -->
    <div class="dropdown">
      <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
        Admin
      </button>

      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="#"> Profil </a>
        </li>

        <li>
          <a class="dropdown-item" href="#"> Pengaturan </a>
        </li>

        <li>
          <hr class="dropdown-divider" />
        </li>

        <li>
          <a class="dropdown-item text-danger" href="#"> Logout </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Content -->
  <main class="content">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-semibold mb-1">Pesanan</h3>

        <p class="text-muted mb-0">Kelola data Pesanan</p>
      </div>

      <!-- <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTambah">
        + Tambah Data
      </button> -->
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
          <div>
            <input type="text" class="form-control" placeholder="Cari Meja..." />
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>No</th>
                <th>Kode Pesanan</th>
                <th>Tipe</th>
                <th>Meja</th>
                <th>Status</th>
                <th>Total</th>
              </tr>
            </thead>
            <!-- untuk edit table ada file pesanan-search.js -->
            <tbody id="menu-tbody">
              <% i=1; pesanans.forEach(pesanan =>  {  %>
              <tr>
                <td><%= i++ %></td>
                <td>
                  <strong><%= pesanan.id_pesanan %></strong>
                </td>
                <td>
                  <span class="badge text-bg-primary">Dine In</span>
                  <span class="badge text-bg-dark">Take Away</span>
                </td>
                <td>
                  <strong><%= pesanan.id_meja %></strong>
                </td>
                <td>
                  <div class="btn-group btn-group-sm" role="group" aria-label="Basic radio toggle button group">
                    <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
                    <label class="btn btn-outline-warning" for="btnradio1">Pending</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
                    <label class="btn btn-outline-primary" for="btnradio2">Dibayar</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off">
                    <label class="btn btn-outline-info" for="btnradio3">Diproses</label>

                    <input type="radio" class="btn-check" name="btnradio" id="btnradio4" autocomplete="off">
                    <label class="btn btn-outline-success" for="btnradio4">Selesai</label>
                  </div>
                </td>
                <td>
                  <%= pesanan.totalText %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <!-- <nav class="mt-3">
          <ul class="pagination justify-content-end mb-0">
            <li class="page-item disabled">
              <a class="page-link" href="#"> Previous </a>
            </li>

            <li class="page-item active">
              <a class="page-link" href="#"> 1 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 2 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 3 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> Next </a>
            </li>
          </ul>
        </nav> -->
      </div>
    </div>
  </main>
</div>

<!-- ================= MODAL TAMBAH ================= -->

<div class="modal fade" id="modalTambah" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Tambah Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form method="post" action="<%= apiBase %>/api/meja/add">
          <div class="mb-3">
            <label class="form-label"> Nama Meja </label>
            <input type="text" class="form-control" placeholder="Masukkan nama meja" name="nama_meja" required/>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              Batal
            </button>
    
            <button type="submit" class="btn btn-primary">Simpan</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- ================= MODAL EDIT ================= -->

<div class="modal fade" id="modalEditMeja" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Meja</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form method="post" action="<%= apiBase %>/api/meja/edit/0">
          <input type="hidden" class="form-control" name="id" required/>
          <input type="hidden" class="form-control" name="oldNama" required/>
          <div class="mb-3">
            <label class="form-label"> Nama Meja </label>
            <input type="text" class="form-control" placeholder="Masukkan nama meja" name="nama_meja" required/>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              Batal
            </button>
    
            <button type="submit" class="btn btn-primary">Simpan</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>