<!-- ================= MAIN ================= -->

<div class="main">
  <!-- Top Navbar -->
  <nav class="topbar d-flex align-items-center justify-content-between">
    <div>
      <h6 class="mb-0">Pesanan</h6>

      <small class="text-muted"> Management / Pesanan </small>
    </div>

    <!-- User -->
    <div class="dropdown">
      <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
        Admin
      </button>

      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="#"> Profil </a>
        </li>

        <li>
          <a class="dropdown-item" href="#"> Pengaturan </a>
        </li>

        <li>
          <hr class="dropdown-divider" />
        </li>

        <li>
          <a class="dropdown-item text-danger" href="#"> Logout </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Content -->
  <main class="content">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-semibold mb-1">Pesanan</h3>

        <p class="text-muted mb-0">Kelola data Pesanan</p>
      </div>

      <!-- <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTambah">
        + Tambah Data
      </button> -->
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
          <div class="col-md-3">
            <input type="text" id="cari-pesanan" class="form-control" placeholder="Cari kode / tipe / meja / status..." autocomplete="off" />
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-primary">
              <tr>
                <th>No</th>
                <th>Kode Pesanan</th>
                <th>Tipe</th>
                <th>Meja</th>
                <th>Status</th>
                <th>Total</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <!-- untuk edit table ada file pesanan-search.js -->
            <tbody id="pesanan-tbody">
              
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <!-- <nav class="mt-3">
          <ul class="pagination justify-content-end mb-0">
            <li class="page-item disabled">
              <a class="page-link" href="#"> Previous </a>
            </li>

            <li class="page-item active">
              <a class="page-link" href="#"> 1 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 2 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 3 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> Next </a>
            </li>
          </ul>
        </nav> -->
      </div>
    </div>
  </main>
</div>

<!-- ================= MODAL KONFIRMASI STATUS ================= -->

<div class="modal fade" id="modalKonfirmasiStatus" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Ubah Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p id="teks-konfirmasi-status" class="mb-0">Ubah status pesanan?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tidak</button>
        <button type="button" class="btn btn-primary" id="btn-status-ya" data-bs-dismiss="modal">Ya, ubah</button>
      </div>
    </div>
  </div>
</div>

<!-- ================= MODAL DETAIL ================= -->

<div class="modal fade" id="modalDetailPesanan" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Detail Pesanan</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body py-3 px-5">
        <p class="mb-3">
          <strong>Kode pesanan :</strong>
          <span id="detail-kode-pesanan"></span>
        </p>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-primary">
              <tr>
                <th>No</th>
                <th>Menu</th>
                <th>Harga</th>
                <th>Qty</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody id="detail-pesanan-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

