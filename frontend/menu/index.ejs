<!-- ================= MAIN ================= -->

<div class="main">
  <!-- Top Navbar -->
  <nav class="topbar d-flex align-items-center justify-content-between">
    <div>
      <h6 class="mb-0">Menu</h6>

      <small class="text-muted"> Management / Menu </small>
    </div>

    <!-- User -->
    <div class="dropdown">
      <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
        Admin
      </button>

      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <a class="dropdown-item" href="#"> Profil </a>
        </li>

        <li>
          <a class="dropdown-item" href="#"> Pengaturan </a>
        </li>

        <li>
          <hr class="dropdown-divider" />
        </li>

        <li>
          <a class="dropdown-item text-danger" href="#"> Logout </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Content -->
  <main class="content">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h3 class="fw-semibold mb-1">Menu</h3>

        <p class="text-muted mb-0">Kelola data menu</p>
      </div>

      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTambah">
        + Tambah Menu
      </button>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
          <div>
            <input type="text" id="cari-menu" class="form-control" placeholder="Cari menu..." autocomplete="off" />
          </div>

          <select id="filter-kategori" class="form-select" style="width: 150px">
            <option>Semua Kategori</option>
            <option>Makanan</option>
            <option>Minuman</option>
          </select>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>No</th>
                <th>Nama Menu</th>
                <th>Kategori</th>
                <th>Harga</th>
                <th>Stok</th>
                <th>Status</th>
                <th>Favorit</th>
                <th>Foto</th>
                <th>Aksi</th>
              </tr>
            </thead>

            <!-- untuk edit table ada file menu-search.js -->
            <tbody id="menu-tbody">
              <% i=1; menus.forEach(menu =>  {  %>
              
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <nav class="mt-3">
          <ul class="pagination justify-content-end mb-0">
            <li class="page-item disabled">
              <a class="page-link" href="#"> Previous </a>
            </li>

            <li class="page-item active">
              <a class="page-link" href="#"> 1 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 2 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> 3 </a>
            </li>

            <li class="page-item">
              <a class="page-link" href="#"> Next </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </main>
</div>

<!-- ================= MODAL TAMBAH ================= -->

<div class="modal fade" id="modalTambah" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Tambah Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form method="post" action="<%= apiBase %>/api/menu/add" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label"> Nama Menu </label>
            <input type="text" class="form-control" placeholder="Masukkan nama menu" name="nama" required/>
          </div>

          <div class="mb-3">
            <label class="form-label"> Kategori </label>
            <select class="form-select" name="kategori">
              <option selected>Pilih kategori</option>
              <option value="Makanan">Makanan</option>
              <option value="Minuman">Minuman</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label"> Harga </label>
            <input type="number" class="form-control" placeholder="Masukkan harga" name="harga" required/>
          </div>

          <div class="mb-3">
            <label class="form-label">Pilih Favorit </label>
            <select class="form-select" name="star">
              <option value="0">No-Favorit 🚫</option>
              <option value="1">Favorit ⭐</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="formFile" class="form-label">Foto</label>
            <input class="form-control" type="file" name="foto" id="formFile">
          </div>

          <label class="form-label">Deskripsi</label>
          <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea2" style="height: 100px" name="deskripsi"></textarea>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              Batal
            </button>
            <button type="submit" class="btn btn-primary">Simpan</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- ================= MODAL EDIT ================= -->

<div class="modal fade" id="modalEditMenu" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form method="post" action="<%= apiBase %>/api/menu/edit/0" enctype="multipart/form-data">
          <input type="hidden" class="form-control" placeholder="Masukkan nama menu" name="id" required/>
          <input type="hidden" class="form-control" placeholder="Masukkan nama menu" name="oldNama" required/>
          <div class="mb-3">
            <label class="form-label"> Nama Menu </label>
            <input type="text" class="form-control" placeholder="Masukkan nama menu" name="nama" required/>
          </div>

          <div class="mb-3">
            <label class="form-label"> Kategori </label>
            <select class="form-select" name="kategori">
              <option selected>Pilih kategori</option>
              <option value="Makanan">Makanan</option>
              <option value="Minuman">Minuman</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label"> Harga </label>
            <input type="number" class="form-control" placeholder="Masukkan harga" name="harga" required/>
          </div>

          <div class="mb-3">
            <label class="form-label">Pilih Favorit </label>
            <select class="form-select" name="star">
              <option value="0">No-Favorit 🚫</option>
              <option value="1">Favorit ⭐</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="formFile" class="form-label">Foto</label>
            <input class="form-control" type="file" name="foto" id="formFile">
          </div>

          <label class="form-label">Comments</label>
          <textarea class="form-control" placeholder="Leave a comment here" id="floatingTextarea2" style="height: 100px" name="deskripsi"></textarea>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              Batal
            </button>
    
            <button type="submit" class="btn btn-primary">Simpan</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- ================= MODAL DETAIL FOTO ================= -->

<div class="modal fade" id="modalDetailMenu" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Detail Foto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p id="nama-detail-menu" class="fw-bold mb-2">Nama Menu</p>
        <img id="foto-detail-menu" class="rounded img-fluid" width="250" alt="Foto menu">
      </div>
    </div>
  </div>
</div>

<script src="/js/menu-search.js"></script>
<script src="/js/menu-edit.js"></script>