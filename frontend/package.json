{
    "name": "frontend",
    "version": "1.0.0",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./user/src/input.css -o ./public/user/css/style.css",
        "watch:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./user/src/input.css -o ./public/user/css/style.css --watch"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-ejs-layouts": "^2.5.1",
        "http-proxy-middleware": "^2.0.10",
        "tw-animations": "^2.0.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "nodemon": "^3.1.14",
        "tailwindcss": "^4.3.3"
    }
}
